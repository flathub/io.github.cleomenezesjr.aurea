{
  "app-id": "io.github.cleomenezesjr.aurea",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "aurea",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--filesystem=home"
  ],
  "cleanup-commands": [
    "python3 -m compileall --invalidation-mode=unchecked-hash /app"
  ],
  "modules": [
    "python3-pybind11.json",
    "python3-pillow.json",
    {
      "name": "aurea",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/CleoMenezesJr/Aurea.git",
          "tag": "1.6.1",
          "commit": "99a18aec7e9ca874178072dfe98f71b36551a3fa"
        }
      ]
    }
  ]
}
